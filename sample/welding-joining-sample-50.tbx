<?xml version="1.0" encoding="UTF-8"?>
<tbx type="TBX-Basic" style="dca" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
<tbxHeader><fileDesc><sourceDesc><p>Diffusion Works — Welding &amp; Joining Termbase — evaluation sample (50 terms). Non-commercial evaluation use only.</p></sourceDesc></fileDesc></tbxHeader>
<text><body>
<conceptEntry id="WELD-00073"><descrip type="subjectField">weld / arc-processes</descrip><descrip type="definition">Flux-cored arc welding in which the core ingredients alone provide shielding of the arc and weld pool, so no external shielding gas is supplied; ISO 4063 process 114.</descrip><admin type="source">ISO 4063 Welding, brazing, soldering and cutting — Nomenclature of processes and reference numbers</admin><langSec xml:lang="en"><termSec><term>self-shielded flux cored arc welding</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>FCAW-S</term><termNote type="termType">abbreviation</termNote><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>self-shielded FCAW</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>self-shielded flux-cored arc welding</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>gasless welding</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>セルフシールドアーク溶接</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ノンガスシールドアーク溶接</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>自保护药芯焊丝电弧焊</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>셀프 실드 플럭스 코어드 아크 용접</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Metall-Lichtbogenschweißen mit Fülldrahtelektrode ohne Schutzgas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Fülldrahtschweißen ohne Schutzgas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>soldadura por arco con alambre tubular autoprotegido</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>soldeo por arco con alambre tubular sin protección gaseosa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00128"><descrip type="subjectField">weld / arc-processes</descrip><descrip type="definition">Hole formed through the full thickness of the workpiece at the leading edge of the weld pool by a concentrated plasma arc or beam; molten metal flows around it and closes behind it, giving full penetration.</descrip><admin type="source">AWS A3.0M/A3.0:2020 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>keyhole</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>キーホール</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>鍵穴</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「鍵穴」（日本語）は錠前の鍵穴を指す日常語で、溶接では使わない（キーホール）。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>匙孔</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>小孔</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>锁孔</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>키홀</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Keyhole</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Stichloch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Dampfkapillare</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>keyhole</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ojo de cerradura</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00230"><descrip type="subjectField">weld / arc-processes</descrip><descrip type="definition">Planned overlap of each new weld bead on the previous one in cladding, surfacing or multipass layers, usually expressed as a percentage of bead width, to obtain a smooth surface and uniform dilution.</descrip><admin type="source">Norrish, Advanced Welding Processes, Woodhead Publishing</admin><langSec xml:lang="en"><termSec><term>bead overlap</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>bead overlapping</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>overlap of beads</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>ビードの重なり</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>焊道搭接</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>焊道重叠</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>焊瘤</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「焊瘤」（中国語）、「Schweißgutüberlauf」（ドイツ語）は溶接欠陥のオーバラップ（溶融金属が止端で母材にかぶさった不完全部）で、隣接ビードの計画的な重なりを指さない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>비드 겹침</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Raupenüberlappung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schweißgutüberlauf</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「焊瘤」（中国語）、「Schweißgutüberlauf」（ドイツ語）は溶接欠陥のオーバラップ（溶融金属が止端で母材にかぶさった不完全部）で、隣接ビードの計画的な重なりを指さない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>solapamiento de cordones</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00242"><descrip type="subjectField">weld / arc-equipment</descrip><descrip type="definition">Welding power source that rectifies the mains supply, switches it at high frequency through semiconductor devices into a small transformer and rectifies it again, giving a compact, light unit with fast output control.</descrip><admin type="source">IEC 60974-1 Arc welding equipment — Part 1: Welding power sources</admin><langSec xml:lang="en"><termSec><term>inverter power source</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>inverter welding power source</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>inverter welder</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>inverter-type power source</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>インバータ式アーク溶接電源</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>インバータ溶接電源</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>インバータ溶接機</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>逆变式弧焊电源</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>逆变焊机</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>인버터 용접 전원</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>인버터 용접기</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Inverter-Schweißstromquelle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Inverterstromquelle</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>fuente de soldadura inverter</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>fuente de corriente de tipo inversor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00250"><descrip type="subjectField">weld / arc-equipment</descrip><descrip type="definition">Iron-cored inductor in the output circuit of a welding power source that smooths the current and limits the rate of current change, notably during short-circuit metal transfer.</descrip><admin type="source">Lincoln Electric, The Procedure Handbook of Arc Welding, 14th ed.</admin><langSec xml:lang="en"><termSec><term>reactor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>DC reactor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>choke</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>inductor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>リアクトル</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>直流リアクトル</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>反応器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec><termSec><term>原子炉</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>电抗器</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>直流电抗器</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>反应器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec><termSec><term>反应堆</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>리액터</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>직류 리액터</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>반응기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec><termSec><term>원자로</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Drossel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Glättungsdrossel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Drosselspule</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Reaktor</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「反応器」「原子炉」（中国語「反应器」「反应堆」、韓国語「반응기」「원자로」、ドイツ語 Reaktor）は化学反応装置・原子炉の語で、溶接電源の電流平滑用インダクタにはならない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>bobina de reactancia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>reactor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00449"><descrip type="subjectField">weld / arc-equipment</descrip><descrip type="definition">Free length of wire electrode between the end of the contact tip and the arc in wire-fed processes (or of a tungsten electrode beyond the gas cup in GTAW), which affects resistive preheating of the wire and arc stability.</descrip><admin type="source">AWS A3.0M/A3.0:2020 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>electrode extension</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>stickout</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>electrode stickout</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>突出し長さ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ワイヤ突出し長さ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>スティックアウト長さ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>エクステンション</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>電極延長</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語「電極延長」は electrode extension の直訳で、コンタクトチップ先端から突き出たワイヤの長さ（突出し長さ）の意味にならない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>伸出长度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>干伸长</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>焊丝伸出长度</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>돌출 길이</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>스틱아웃</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>freies Drahtende</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Stickout</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>extensión del electrodo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>stickout</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>longitud libre del alambre</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00622"><descrip type="subjectField">weld / resistance-welding</descrip><descrip type="definition">In resistance welding, the interval without welding current between successive current impulses of a pulsation or multi-impulse schedule, while the electrode force is kept.</descrip><admin type="source">ISO 17677-1 (Resistance welding — Vocabulary — Part 1: Spot, projection and seam welding); JIS Z 3001-6:2013 4.4.1</admin><langSec xml:lang="en"><termSec><term>cool time</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>cool</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>interpulse time</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>cooling time</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>冷却時間</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>クール時間</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>冷却时间</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>间歇时间</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>냉각 시간</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>쿨 타임</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Pausenzeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Kühlzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>tiempo de enfriamiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>tiempo de pausa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00646"><descrip type="subjectField">weld / resistance-welding</descrip><descrip type="definition">Combination of sheets placed between the electrodes for a resistance spot weld, described by the number, thicknesses, grades and coatings of the sheets, on which the welding schedule is based.</descrip><admin type="source">AWS D8.1M Specification for Automotive Weld Quality — Resistance Spot Welding of Steel</admin><langSec xml:lang="en"><termSec><term>stack-up</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>sheet stack-up</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>sheet combination</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>板組み合わせ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>板組み</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>板組</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>板材组合</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>板组</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>堆栈</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「堆栈」は中国語でソフトウェアのスタック（データ構造）を指し、スポット溶接の板組みには使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>판 조합</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Blechkombination</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>combinación de chapas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>apilamiento de chapas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00787"><descrip type="subjectField">weld / resistance-welding</descrip><descrip type="definition">Steel sheet hot-dip galvanized and then heated so that the zinc coating alloys with iron, giving a Zn-Fe coating whose higher contact resistance and harder coating influence spot weldability and electrode life.</descrip><admin type="source">ISO 14373 (Resistance welding — Procedure for spot welding of uncoated and coated low carbon steels)</admin><langSec xml:lang="en"><termSec><term>galvannealed steel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>GA</term><termNote type="termType">abbreviation</termNote><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>galvannealed sheet</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>GA steel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>合金化溶融亜鉛めっき鋼板</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>GA鋼板</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>ガルバリウム鋼板</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「ガルバリウム鋼板」は55%アルミニウム-亜鉛合金めっき鋼板の呼び名（商標）で、亜鉛-鉄合金めっきの合金化溶融亜鉛めっき鋼板とは別の製品。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>合金化热镀锌钢板</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>锌铁合金镀层钢板</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>합금화 용융아연도금 강판</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>GA 강판</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Stahlblech mit Zink-Eisen-Legierungsüberzug</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Galvannealed-Blech</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>acero galvanorrecocido</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>acero galvannealed</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00839"><descrip type="subjectField">weld / beam-welding</descrip><descrip type="definition">Electron beam welding carried out with the workpiece inside an evacuated chamber, which avoids beam scattering and gives deep, narrow welds; ISO 4063 process 511.</descrip><admin type="source">ISO 4063 Welding, brazing, soldering and cutting — Nomenclature of processes and reference numbers; JIS Z 3001-2:2018 Welding and allied processes — Vocabulary — Part 2: Welding processes</admin><langSec xml:lang="en"><termSec><term>electron beam welding in vacuum</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>EB welding in vacuum</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>vacuum electron beam welding</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>真空電子ビーム溶接</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>真空电子束焊</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>진공 전자 빔 용접</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Elektronenstrahlschweißen im Vakuum</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>soldeo por haz de electrones en vacío</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00845"><descrip type="subjectField">weld / beam-welding</descrip><descrip type="definition">Solid-state laser whose gain medium is an optical fiber doped with a rare-earth element, usually ytterbium, pumped by laser diodes and emitting near 1.07 µm, widely used for welding and cutting.</descrip><admin type="source">JIS Z 3001-5:2013 溶接用語－第5部：レーザ溶接; IPG Photonics: fiber laser welding (public technical pages)</admin><langSec xml:lang="en"><termSec><term>fiber laser</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>fibre laser</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>ytterbium fiber laser</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>ファイバーレーザ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ファイバーレーザー</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>ファイバレーザ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>繊維レーザ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「繊維レーザ」（日本語）・「纤维激光器」（中国語）は fiber を織物の繊維と取り違えた直訳で、光ファイバを利得媒質とするレーザには使わない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>光纤激光器</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>纤维激光器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「繊維レーザ」（日本語）・「纤维激光器」（中国語）は fiber を織物の繊維と取り違えた直訳で、光ファイバを利得媒質とするレーザには使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>파이버 레이저</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>광섬유 레이저</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Faserlaser</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>láser de fibra</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-00867"><descrip type="subjectField">weld / beam-welding</descrip><descrip type="definition">For a pulsed or modulated laser, the ratio of the pulse duration to the pulse period, usually given in percent.</descrip><admin type="source">ISO 11145 (Optics and photonics — Lasers and laser-related equipment — Vocabulary and symbols); JIS Z 3001-5:2013</admin><langSec xml:lang="en"><termSec><term>duty cycle (laser)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>pulse duty cycle</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>duty factor (pulsed laser)</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>パルスデューティ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>デューティ比</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>使用率</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「使用率」（日本語）、「负载持续率」（中国語）、「사용률」（韓国語）、「Einschaltdauer」（ドイツ語）、「factor de marcha」（スペイン語）は溶接電源の定格使用率（10 分周期で出力できる時間の割合）を表し、レーザのパルスのオン時間比にはならない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>占空比</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>负载持续率</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「使用率」（日本語）、「负载持续率」（中国語）、「사용률」（韓国語）、「Einschaltdauer」（ドイツ語）、「factor de marcha」（スペイン語）は溶接電源の定格使用率（10 分周期で出力できる時間の割合）を表し、レーザのパルスのオン時間比にはならない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>듀티 사이클</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>듀티비</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>사용률</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「使用率」（日本語）、「负载持续率」（中国語）、「사용률」（韓国語）、「Einschaltdauer」（ドイツ語）、「factor de marcha」（スペイン語）は溶接電源の定格使用率（10 分周期で出力できる時間の割合）を表し、レーザのパルスのオン時間比にはならない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Tastverhältnis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Einschaltdauer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「使用率」（日本語）、「负载持续率」（中国語）、「사용률」（韓国語）、「Einschaltdauer」（ドイツ語）、「factor de marcha」（スペイン語）は溶接電源の定格使用率（10 分周期で出力できる時間の割合）を表し、レーザのパルスのオン時間比にはならない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>ciclo de trabajo del pulso</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>factor de marcha</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「使用率」（日本語）、「负载持续率」（中国語）、「사용률」（韓国語）、「Einschaltdauer」（ドイツ語）、「factor de marcha」（スペイン語）は溶接電源の定格使用率（10 分周期で出力できる時間の割合）を表し、レーザのパルスのオン時間比にはならない。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01085"><descrip type="subjectField">weld / solid-state-joining</descrip><descrip type="definition">Solid-state welding process in which high-frequency vibration applied parallel to the faying surfaces under moderate pressure breaks up surface oxides and bonds overlapping metal parts without melting them.</descrip><admin type="source">ISO 4063:2009 Welding and allied processes — Nomenclature of processes and reference numbers</admin><langSec xml:lang="en"><termSec><term>ultrasonic welding</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>USW</term><termNote type="termType">abbreviation</termNote><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>ultrasonic metal welding</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>超音波溶接</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>超音波接合</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>超音波圧接</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>超声波焊</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>超声波焊接</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>초음파 용접</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Ultraschallschweißen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>soldeo por ultrasonidos</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>soldadura por ultrasonidos</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01089"><descrip type="subjectField">weld / solid-state-joining</descrip><descrip type="definition">Solid-state welding in which the parts are heated in a forge or furnace and joined by hammering, pressing or rolling, historically the first welding process and still used for forge-welded pipe.</descrip><admin type="source">AWS A3.0M/A3.0 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>forge welding</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>FOW</term><termNote type="termType">abbreviation</termNote><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>forge weld</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>smith welding</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>鍛接</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>鍛造</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「鍛造」「锻造」（中国語）「단조」（韓国語）「Schmieden」（ドイツ語）「forjado」（スペイン語）は接合を伴わない鍛造加工を指し、加熱した部材を打撃・加圧して接合する鍛接とは別概念。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>锻焊</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>锻造</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「鍛造」「锻造」（中国語）「단조」（韓国語）「Schmieden」（ドイツ語）「forjado」（スペイン語）は接合を伴わない鍛造加工を指し、加熱した部材を打撃・加圧して接合する鍛接とは別概念。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>단접</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>단조</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「鍛造」「锻造」（中国語）「단조」（韓国語）「Schmieden」（ドイツ語）「forjado」（スペイン語）は接合を伴わない鍛造加工を指し、加熱した部材を打撃・加圧して接合する鍛接とは別概念。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Feuerschweißen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schmiedeschweißen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Hammerschweißen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Schmieden</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「鍛造」「锻造」（中国語）「단조」（韓国語）「Schmieden」（ドイツ語）「forjado」（スペイン語）は接合を伴わない鍛造加工を指し、加熱した部材を打撃・加圧して接合する鍛接とは別概念。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>soldeo por forja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>soldadura por forja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>forjado</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「鍛造」「锻造」（中国語）「단조」（韓国語）「Schmieden」（ドイツ語）「forjado」（スペイン語）は接合を伴わない鍛造加工を指し、加熱した部材を打撃・加圧して接合する鍛接とは別概念。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01228"><descrip type="subjectField">weld / solid-state-joining</descrip><descrip type="definition">Steel plate covered over its whole surface by a layer of another metal, such as stainless steel, nickel alloy or titanium, metallurgically bonded by roll bonding, explosion welding or weld overlay.</descrip><admin type="source">ASTM A264 Standard Specification for Stainless Chromium-Nickel Steel-Clad Plate</admin><langSec xml:lang="en"><termSec><term>clad plate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>clad steel plate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>クラッド鋼板</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>めっき鋼板</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「めっき鋼板」（日本語）、「镀层钢板」（中国語）はめっきで表面処理した鋼板で、合わせ材を金属学的に接合したクラッド鋼板とは別物。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>复合钢板</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>镀层钢板</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「めっき鋼板」（日本語）、「镀层钢板」（中国語）はめっきで表面処理した鋼板で、合わせ材を金属学的に接合したクラッド鋼板とは別物。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>클래드 강판</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>plattiertes Blech</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>chapa de acero plaqueado</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01295"><descrip type="subjectField">weld / adhesive-mechanical-joining</descrip><descrip type="definition">Joint between two parts made of different metals or alloy systems, for example steel to aluminum or ferritic to austenitic steel, made by welding, brazing or another joining method.</descrip><admin type="source">K. Martinsen, S.J. Hu, B.E. Carlson, Joining of dissimilar materials, CIRP Annals 64(2) (2015) 679–699; ISO 15614-1:2017 Specification and qualification of welding procedures for metallic materials — Welding procedure test — Part 1: Arc and gas welding of steels and arc welding of nickel and nickel alloys</admin><langSec xml:lang="en"><termSec><term>dissimilar metal joint</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>dissimilar joint</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>dissimilar metal weld joint</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>dissimilar material joint</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>異材継手</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>异种金属接头</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>이종 금속 이음</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>이종 금속 접합부</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Mischverbindung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Verbindung artungleicher Werkstoffe</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>unión de metales disímiles</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>unión disímil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01333"><descrip type="subjectField">weld / brazing-soldering</descrip><descrip type="definition">Soldering in which the joint is heated with a fuel gas flame from a hand-held or mechanized torch, as in plumbing joints of copper tube.</descrip><admin type="source">AWS A3.0M/A3.0 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>torch soldering</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>TS</term><termNote type="termType">abbreviation</termNote><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>flame soldering</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>炎はんだ付</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>トーチはんだ付</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>火焰软钎焊</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>토치 연납땜</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>불꽃 연납땜</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Flammweichlöten</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>soldeo blando con llama</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01462"><descrip type="subjectField">weld / brazing-soldering</descrip><descrip type="definition">Concave meniscus of brazing filler metal that forms at the edges of a brazed joint where the filler leaves the capillary gap.</descrip><admin type="source">ISO 857-2:2005 Welding and allied processes — Vocabulary — Part 2: Soldering and brazing processes and related terms; JIS Z 3001-3 Welding and allied processes — Vocabulary — Part 3: Soldering and brazing</admin><langSec xml:lang="en"><termSec><term>braze fillet</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>fillet</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>フィレット</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ろう付フィレット</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>すみ肉</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「すみ肉」、中国語の「角焊缝」、韓国語の「필릿 용접」、ドイツ語の「Kehlnaht」はすみ肉溶接（fillet weld）を指す語で、ろう付継手の端にできるろうのフィレットには使わない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>钎角</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>角焊缝</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「すみ肉」、中国語の「角焊缝」、韓国語の「필릿 용접」、ドイツ語の「Kehlnaht」はすみ肉溶接（fillet weld）を指す語で、ろう付継手の端にできるろうのフィレットには使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>브레이징 필릿</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>필릿 용접</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「すみ肉」、中国語の「角焊缝」、韓国語の「필릿 용접」、ドイツ語の「Kehlnaht」はすみ肉溶接（fillet weld）を指す語で、ろう付継手の端にできるろうのフィレットには使わない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Lotkehle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Kehlnaht</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「すみ肉」、中国語の「角焊缝」、韓国語の「필릿 용접」、ドイツ語の「Kehlnaht」はすみ肉溶接（fillet weld）を指す語で、ろう付継手の端にできるろうのフィレットには使わない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>filete de soldadura fuerte</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01501"><descrip type="subjectField">weld / brazing-soldering</descrip><descrip type="definition">Oxy-fuel gas flame with more fuel gas than needed for complete combustion, recognized by a feather around the inner cone, used for some brazing and hardfacing.</descrip><admin type="source">AWS C3.4M/C3.4 Specification for Torch Brazing; JIS Z 3001-1:2018 4.7.3; AWS A3.0M/A3.0:2020 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>reducing flame</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>carburizing flame</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>carburising flame</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>excess fuel gas flame</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>excess acetylene flame</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>還元炎</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>炭化炎</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>浸炭炎</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「浸炭炎」（日本語）・「渗碳焰」（中国語）は熱処理の浸炭（carburizing）から作った直訳で、燃料ガス過剰の炎の名称には使わない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>碳化焰</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>还原焰</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>渗碳焰</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「浸炭炎」（日本語）・「渗碳焰」（中国語）は熱処理の浸炭（carburizing）から作った直訳で、燃料ガス過剰の炎の名称には使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>환원 불꽃</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>탄화 불꽃</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>reduzierende Flamme</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Brenngasüberschussflamme</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Flamme mit Acetylenüberschuss</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>aufkohlende Flamme</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>llama reductora</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>llama carburante</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01519"><descrip type="subjectField">weld / procedure-qualification</descrip><descrip type="definition">Chemical cleaning of stainless steel welds and fabrications in an acid solution or paste, typically nitric-hydrofluoric acid, to remove heat tint, scale and the chromium-depleted layer beneath it.</descrip><admin type="source">ASTM A380/A380M Standard Practice for Cleaning, Descaling, and Passivation of Stainless Steel Parts, Equipment, and Systems</admin><langSec xml:lang="en"><termSec><term>pickling</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>acid pickling</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>酸洗い</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>酸洗</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>酸洗</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>산세</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>산세척</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Beizen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>decapado</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>decapado químico</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>encurtido</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>スペイン語の「encurtido」は食品の酢漬けを指す辞書訳で、金属の酸洗いには使わない。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01611"><descrip type="subjectField">weld / thermal-cutting</descrip><descrip type="definition">Time the preheat flame is held on the starting point in oxyfuel cutting until the steel reaches its ignition temperature, before the cutting oxygen is turned on.</descrip><admin type="source">ESAB cutting systems and consumables — public catalogues and manuals</admin><langSec xml:lang="en"><termSec><term>preheating time</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>preheat time</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>予熱時間</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>预热时间</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>예열 시간</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Anwärmzeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Vorwärmzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>tiempo de precalentamiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01622"><descrip type="subjectField">weld / thermal-cutting</descrip><descrip type="definition">Venturi nozzle in an injector-type gas torch in which the high-velocity oxygen jet draws in fuel gas supplied at low pressure and mixes with it before the flame.</descrip><admin type="source">ISO 5172 Gas welding equipment — Blowpipes for gas welding, heating and cutting — Specifications and tests</admin><langSec xml:lang="en"><termSec><term>injector</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>injector nozzle</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>インゼクタ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>インジェクタ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>燃料噴射弁</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「燃料噴射弁」「喷油器」（中国語）「Einspritzdüse」（ドイツ語）はエンジンの燃料噴射装置を指し、低圧式吹管で酸素噴流により燃料ガスを吸引混合するインゼクタとは別物。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>射吸管</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>射吸器</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>喷油器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「燃料噴射弁」「喷油器」（中国語）「Einspritzdüse」（ドイツ語）はエンジンの燃料噴射装置を指し、低圧式吹管で酸素噴流により燃料ガスを吸引混合するインゼクタとは別物。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>인젝터</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Injektor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Injektordüse</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Einspritzdüse</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「燃料噴射弁」「喷油器」（中国語）「Einspritzdüse」（ドイツ語）はエンジンの燃料噴射装置を指し、低圧式吹管で酸素噴流により燃料ガスを吸引混合するインゼクタとは別物。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>inyector</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01672"><descrip type="subjectField">weld / thermal-cutting</descrip><descrip type="definition">Removal of surface defects such as cracks and seams from steel slabs, blooms or billets by a wide oxygen-fuel flame that burns away a thin surface layer, by hand or with a scarfing machine.</descrip><admin type="source">AWS A3.0M/A3.0:2020 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>scarfing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>flame scarfing</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>oxygen scarfing</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>スカーフィング</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>スカーフ継手</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「スカーフ継手」（日本語）、「斜接接头」（中国語）、「Schäftung」（ドイツ語）は端部を斜めに削いで重ねる継手（scarf joint）を指し、鋼片表面を酸素炎で除去する作業にはならない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>火焰清理</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>斜接接头</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「スカーフ継手」（日本語）、「斜接接头」（中国語）、「Schäftung」（ドイツ語）は端部を斜めに削いで重ねる継手（scarf joint）を指し、鋼片表面を酸素炎で除去する作業にはならない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>스카핑</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Flämmen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schäftung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「スカーフ継手」（日本語）、「斜接接头」（中国語）、「Schäftung」（ドイツ語）は端部を斜めに削いで重ねる継手（scarf joint）を指し、鋼片表面を酸素炎で除去する作業にはならない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>escarpado</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01771"><descrip type="subjectField">weld / consumables-gases</descrip><descrip type="definition">Covered electrode for manual metal arc welding of creep-resisting low-alloy steels such as Mo, Cr-Mo and Cr-Mo-V grades used at elevated temperature, classified in ISO 3580.</descrip><admin type="source">ISO 3580 Welding consumables — Covered electrodes for manual metal arc welding of creep-resisting steels — Classification</admin><langSec xml:lang="en"><termSec><term>creep-resisting steel electrode</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>creep-resisting steel covered electrode</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Cr-Mo electrode</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>covered electrode for creep-resisting steels</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>モリブデン鋼及びクロムモリブデン鋼用被覆アーク溶接棒</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>低合金耐熱鋼用被覆アーク溶接棒</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>热强钢焊条</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>珠光体耐热钢焊条</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>내크립강 피복 아크 용접봉</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>내크립강용 피복 용접봉</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>umhüllte Stabelektrode für warmfeste Stähle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>electrodo revestido para aceros resistentes a la fluencia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01778"><descrip type="subjectField">weld / consumables-gases</descrip><descrip type="definition">Electrode covering based mainly on limestone (calcium carbonate) and fluorspar, coded B in ISO 2560-A, which gives a low-hydrogen weld metal with good toughness and crack resistance.</descrip><admin type="source">ISO 2560 Welding consumables — Covered electrodes for manual metal arc welding of non-alloy and fine grain steels — Classification; JIS Z 3211 Covered electrodes for mild steel, high tensile strength steel and low temperature service steel</admin><langSec xml:lang="en"><termSec><term>basic covering</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>basic coating</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>basic-type covering</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>low hydrogen type</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>low-hydrogen covering type</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>low hydrogen type covering</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>塩基性被覆</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>低水素系</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>基本被覆</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「基本被覆」（中国語「基本药皮」、韓国語「기본 피복」）は basic を「基本の」と訳した直訳。ここでの basic は化学の塩基性（石灰石・ほたる石系）を表す。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>碱性药皮</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>低氢型</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>基本药皮</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「基本被覆」（中国語「基本药皮」、韓国語「기본 피복」）は basic を「基本の」と訳した直訳。ここでの basic は化学の塩基性（石灰石・ほたる石系）を表す。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>염기성 피복</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>저수소계</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>기본 피복</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「基本被覆」（中国語「基本药皮」、韓国語「기본 피복」）は basic を「基本の」と訳した直訳。ここでの basic は化学の塩基性（石灰石・ほたる石系）を表す。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>basische Umhüllung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>wasserstoffarmer Umhüllungstyp</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>revestimiento básico</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>tipo de bajo hidrógeno</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>revestimiento de bajo hidrógeno</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01818"><descrip type="subjectField">weld / consumables-gases</descrip><descrip type="definition">Granular mineral flux fed around the wire in submerged arc welding that covers the arc and weld pool, shields and refines the molten metal and forms slag; classified with the wire it is used with.</descrip><admin type="source">ISO 14174 Welding consumables — Fluxes for submerged arc welding and electroslag welding — Classification; JIS Z 3352:2017 サブマージアーク溶接及びエレクトロスラグ溶接用フラックス; ISO 14174:2019 Welding consumables — Fluxes for submerged arc welding and electroslag welding — Classification</admin><langSec xml:lang="en"><termSec><term>submerged arc welding flux</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>SAW flux</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>flux for submerged arc welding</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>submerged arc flux</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>サブマージアーク溶接用フラックス</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>サブマージアークフラックス</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>埋弧焊焊剂</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>埋弧焊用焊剂</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>助焊剂</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「助焊剂」は中国語ではんだ付け用のフラックスを指し、サブマージアーク溶接の粒状フラックスには使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>서브머지드 아크 용접용 플럭스</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>서브머지드 아크 플럭스</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>UP-Schweißpulver</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schweißpulver zum Unterpulverschweißen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>UP-Pulver</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>fundente para soldadura por arco sumergido</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>fundente para arco sumergido</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>fundente para el soldeo por arco sumergido</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-01993"><descrip type="subjectField">weld / joint-design-symbols</descrip><descrip type="definition">Junction where two or more members are, or are to be, joined by welding, brazing or another joining method, defined by the geometric relation of the members (butt, T, lap, corner, edge).</descrip><admin type="source">AWS A3.0M/A3.0 (Standard Welding Terms and Definitions)</admin><langSec xml:lang="en"><termSec><term>joint</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>継手</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>関節</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「関節」（中国語「关节」、韓国語「관절」、ドイツ語「Gelenk」、スペイン語「articulación」）は生体や機構の関節・ヒンジの意味で、部材を接合する継手を指さない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>接头</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>关节</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「関節」（中国語「关节」、韓国語「관절」、ドイツ語「Gelenk」、スペイン語「articulación」）は生体や機構の関節・ヒンジの意味で、部材を接合する継手を指さない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>이음</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>조인트</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>관절</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「関節」（中国語「关节」、韓国語「관절」、ドイツ語「Gelenk」、スペイン語「articulación」）は生体や機構の関節・ヒンジの意味で、部材を接合する継手を指さない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Stoß</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Verbindung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Gelenk</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「関節」（中国語「关节」、韓国語「관절」、ドイツ語「Gelenk」、スペイン語「articulación」）は生体や機構の関節・ヒンジの意味で、部材を接合する継手を指さない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>unión</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>junta</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>articulación</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「関節」（中国語「关节」、韓国語「관절」、ドイツ語「Gelenk」、スペイン語「articulación」）は生体や機構の関節・ヒンジの意味で、部材を接合する継手を指さない。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02015"><descrip type="subjectField">weld / joint-design-symbols</descrip><descrip type="definition">Weld of approximately triangular cross-section that joins two surfaces meeting at an angle, as in T, lap and corner joints.</descrip><admin type="source">ISO 2553 (Welding and allied processes — Symbolic representation on drawings — Welded joints)</admin><langSec xml:lang="en"><termSec><term>fillet weld</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>すみ肉溶接</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>隅肉溶接</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>角焊缝</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>圆角焊</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「圆角焊」（中国語）は角に丸み（R）を付ける意味の直訳で、溶接継手のすみ肉には「角焊缝」を使う。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>필릿 용접</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>필렛 용접</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Kehlnaht</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>soldadura en ángulo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>soldadura de filete</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02063"><descrip type="subjectField">weld / joint-design-symbols</descrip><descrip type="definition">Joint preparation in which the plate edges are left square, without bevelling, and placed with or without a gap for a butt weld.</descrip><admin type="source">AWS A3.0M/A3.0 (Standard Welding Terms and Definitions)</admin><langSec xml:lang="en"><termSec><term>square groove</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>square-groove preparation</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>I-groove</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>square edge preparation</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>I形開先</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>I形坡口</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>I형 그루브</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>I형 개선</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>I-Fuge</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>preparación en I</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02176"><descrip type="subjectField">weld / joint-design-symbols</descrip><descrip type="definition">Orientation of a weld and of the welding direction relative to gravity, such as flat, horizontal, vertical or overhead, defined in ISO 6947 by angles of slope and rotation.</descrip><admin type="source">ISO 6947 (Welding and allied processes — Welding positions); JIS Z 3011:2014 溶接姿勢－傾斜角及び回転角による定義</admin><langSec xml:lang="en"><termSec><term>welding position</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>溶接姿勢</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>溶接位置</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「溶接位置」（日本語）、「용접 위치」（韓国語）は溶接する場所・位置座標の意味になり、重力方向に対する溶接の向きを表さない。日本語・韓国語では「溶接姿勢」「용접 자세」を使う。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>焊接位置</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>용접 자세</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>용접 위치</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「溶接位置」（日本語）、「용접 위치」（韓国語）は溶接する場所・位置座標の意味になり、重力方向に対する溶接の向きを表さない。日本語・韓国語では「溶接姿勢」「용접 자세」を使う。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Schweißposition</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>posición de soldeo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02276"><descrip type="subjectField">weld / welding-metallurgy</descrip><descrip type="definition">All metal that was melted and solidified during welding, consisting of melted filler metal and melted base metal in proportions set by dilution.</descrip><admin type="source">JIS Z 3001-1 (Welding and allied processes — Vocabulary — Part 1: General)</admin><langSec xml:lang="en"><termSec><term>weld metal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>溶接金属</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>溶着金属</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「溶着金属」（日本語）、「熔敷金属」（中国語）、「용착 금속」「용착금속」（韓国語）は溶加材から移行した金属（deposited metal）の意味で、母材の溶融分を含む溶接金属とは別概念。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>焊缝金属</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>熔敷金属</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「溶着金属」（日本語）、「熔敷金属」（中国語）、「용착 금속」「용착금속」（韓国語）は溶加材から移行した金属（deposited metal）の意味で、母材の溶融分を含む溶接金属とは別概念。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>용접 금속</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>용착 금속</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「溶着金属」（日本語）、「熔敷金属」（中国語）、「용착 금속」「용착금속」（韓国語）は溶加材から移行した金属（deposited metal）の意味で、母材の溶融分を含む溶接金属とは別概念。</note></termSec><termSec><term>용착금속</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「溶着金属」（日本語）、「熔敷金属」（中国語）、「용착 금속」「용착금속」（韓国語）は溶加材から移行した金属（deposited metal）の意味で、母材の溶融分を含む溶接金属とは別概念。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Schweißgut</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>metal de soldadura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02283"><descrip type="subjectField">weld / welding-metallurgy</descrip><descrip type="definition">Region of a welded joint made up of the weld metal and the heat-affected zone, as distinct from the unaffected parent metal.</descrip><admin type="source">ISO 17659 (Welding — Multilingual terms for welded joints with illustrations)</admin><langSec xml:lang="en"><termSec><term>weld zone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>welded zone</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>溶接部</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>焊接区</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>용접부</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Schweißzone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>zona de soldadura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02335"><descrip type="subjectField">weld / welding-metallurgy</descrip><descrip type="definition">Ability of a steel to form martensite to a given depth on quenching from the austenitic range, governed by its carbon and alloy content; in welding it indicates how readily the heat-affected zone hardens and becomes prone to cold cracking.</descrip><admin type="source">J. C. Lippold, Welding Metallurgy and Weldability (Wiley, 2015)</admin><langSec xml:lang="en"><termSec><term>hardenability</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>焼入れ性</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>焼入性</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>淬透性</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>淬硬性</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「淬硬性」（中国語）、「Aufhärtbarkeit」（ドイツ語）は焼入れで到達できる最高硬さ（主に炭素量で決まる）を指し、マルテンサイトが生じる深さを表す焼入れ性とは別の性質。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>경화능</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>담금질성</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Härtbarkeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Einhärtbarkeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Aufhärtbarkeit</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「淬硬性」（中国語）、「Aufhärtbarkeit」（ドイツ語）は焼入れで到達できる最高硬さ（主に炭素量で決まる）を指し、マルテンサイトが生じる深さを表す焼入れ性とは別の性質。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>templabilidad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02375"><descrip type="subjectField">weld / welding-metallurgy</descrip><descrip type="definition">Heat treatment of stainless steels and nickel or aluminum alloys at high temperature to dissolve carbides or other precipitates, followed by rapid cooling to keep them in solution; used to restore weld zone corrosion resistance.</descrip><admin type="source">J. C. Lippold, D. J. Kotecki, Welding Metallurgy and Weldability of Stainless Steels (Wiley, 2005)</admin><langSec xml:lang="en"><termSec><term>solution annealing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>solution treatment</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>solution heat treatment</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>固溶化熱処理</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>固溶化処理</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>溶体化処理</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>溶液焼鈍</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「solution」は固溶体の意味。日本語「溶液焼鈍」、中国語「溶液退火」は「溶液（液体）」と取り違えた直訳。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>固溶处理</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>固溶热处理</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>溶液退火</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「solution」は固溶体の意味。日本語「溶液焼鈍」、中国語「溶液退火」は「溶液（液体）」と取り違えた直訳。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>고용화 열처리</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>용체화 처리</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Lösungsglühen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>recocido de solubilización</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>tratamiento de solubilización</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02594"><descrip type="subjectField">weld / weld-defects</descrip><descrip type="definition">Planar discontinuity lying parallel to the surface inside rolled plate, originating from inclusions or pipe in the ingot and not caused by welding, though it can open up at weld edges.</descrip><admin type="source">AWS B1.11M/B1.11 Guide for the Visual Examination of Welds</admin><langSec xml:lang="en"><termSec><term>lamination</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>plate lamination</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>laminar discontinuity</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>ラミネーション</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>積層</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「積層」（日本語）、「层压」（中国語）、「적층」（韓国語）、「Laminierung」（ドイツ語）は板やフィルムを重ね合わせる積層加工の語で、圧延鋼板の内部に板面と平行に生じる層状のきず（ラミネーション）を指さない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>分层</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>夹层</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>层压</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「積層」（日本語）、「层压」（中国語）、「적층」（韓国語）、「Laminierung」（ドイツ語）は板やフィルムを重ね合わせる積層加工の語で、圧延鋼板の内部に板面と平行に生じる層状のきず（ラミネーション）を指さない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>라미네이션</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>적층</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「積層」（日本語）、「层压」（中国語）、「적층」（韓国語）、「Laminierung」（ドイツ語）は板やフィルムを重ね合わせる積層加工の語で、圧延鋼板の内部に板面と平行に生じる層状のきず（ラミネーション）を指さない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Dopplung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Laminierung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「積層」（日本語）、「层压」（中国語）、「적층」（韓国語）、「Laminierung」（ドイツ語）は板やフィルムを重ね合わせる積層加工の語で、圧延鋼板の内部に板面と平行に生じる層状のきず（ラミネーション）を指さない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>laminación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02625"><descrip type="subjectField">weld / weld-defects</descrip><descrip type="definition">Particle of a foreign metal, such as tungsten or copper, trapped in the weld metal.</descrip><admin type="source">ISO 6520-1 Welding and allied processes — Classification of geometric imperfections in metallic materials — Part 1: Fusion welding; JIS Z 3001-4:2013 溶接用語－第4部：溶接不完全部</admin><langSec xml:lang="en"><termSec><term>metallic inclusion</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>metal inclusion</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>foreign metallic inclusion</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>異種金属巻込み</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>金属夹杂</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>금속 혼입</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>금속 개재물</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>metallischer Einschluss</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>inclusión metálica</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02631"><descrip type="subjectField">weld / weld-defects</descrip><descrip type="definition">Imperfection in which the actual penetration of a weld is less than the specified penetration, typically leaving part of the root or joint faces unfused; ISO 6520-1 reference number 402.</descrip><admin type="source">ISO 6520-1 Welding and allied processes — Classification of geometric imperfections in metallic materials — Part 1: Fusion welding; AWS A3.0M/A3.0 Standard Welding Terms and Definitions</admin><langSec xml:lang="en"><termSec><term>incomplete penetration</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>LOP</term><termNote type="termType">abbreviation</termNote><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>lack of penetration</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>incomplete joint penetration</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>IJP</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>溶込不良</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>溶込み不良</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>不完全溶込み</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>融合不良</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「融合不良」（日本語）、「未熔合」（中国語）、「융합 불량」「융합불량」（韓国語）、「Bindefehler」（ドイツ語）、「falta de fusión」（スペイン語）は溶接金属が母材や前パスと融け合っていない融合不良（lack of fusion）の語で、溶込みが規定に達しない溶込不良とは別の不完全部。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>未焊透</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>未熔合</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「融合不良」（日本語）、「未熔合」（中国語）、「융합 불량」「융합불량」（韓国語）、「Bindefehler」（ドイツ語）、「falta de fusión」（スペイン語）は溶接金属が母材や前パスと融け合っていない融合不良（lack of fusion）の語で、溶込みが規定に達しない溶込不良とは別の不完全部。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>용입 불량</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>불완전 용입</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>융합 불량</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「融合不良」（日本語）、「未熔合」（中国語）、「융합 불량」「융합불량」（韓国語）、「Bindefehler」（ドイツ語）、「falta de fusión」（スペイン語）は溶接金属が母材や前パスと融け合っていない融合不良（lack of fusion）の語で、溶込みが規定に達しない溶込不良とは別の不完全部。</note></termSec><termSec><term>융합불량</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「融合不良」（日本語）、「未熔合」（中国語）、「융합 불량」「융합불량」（韓国語）、「Bindefehler」（ドイツ語）、「falta de fusión」（スペイン語）は溶接金属が母材や前パスと融け合っていない融合不良（lack of fusion）の語で、溶込みが規定に達しない溶込不良とは別の不完全部。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>ungenügende Durchschweißung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Bindefehler</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「融合不良」（日本語）、「未熔合」（中国語）、「융합 불량」「융합불량」（韓国語）、「Bindefehler」（ドイツ語）、「falta de fusión」（スペイン語）は溶接金属が母材や前パスと融け合っていない融合不良（lack of fusion）の語で、溶込みが規定に達しない溶込不良とは別の不完全部。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>falta de penetración</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>penetración incompleta</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>falta de fusión</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「融合不良」（日本語）、「未熔合」（中国語）、「융합 불량」「융합불량」（韓国語）、「Bindefehler」（ドイツ語）、「falta de fusión」（スペイン語）は溶接金属が母材や前パスと融け合っていない融合不良（lack of fusion）の語で、溶込みが規定に達しない溶込不良とは別の不完全部。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02640"><descrip type="subjectField">weld / weld-defects</descrip><descrip type="definition">Notch-like depression at the weld toe where the arc has melted away base metal that the deposit did not replace, reducing the section and raising stress.</descrip><admin type="source">ISO 6520-1 Welding and allied processes — Classification of geometric imperfections in metallic materials — Part 1: Fusion welding</admin><langSec xml:lang="en"><termSec><term>undercut</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>アンダカット</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>アンダーカット</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>咬边</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>底切</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「底切」（中国語）はエッチングや機械加工のアンダーカット、「Hinterschnitt」（ドイツ語）は成形品・機械加工の逆勾配形状を指し、溶接止端の溶け込み溝には使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>언더컷</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Einbrandkerbe</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Hinterschnitt</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「底切」（中国語）はエッチングや機械加工のアンダーカット、「Hinterschnitt」（ドイツ語）は成形品・機械加工の逆勾配形状を指し、溶接止端の溶け込み溝には使わない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>mordedura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>socavadura</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02733"><descrip type="subjectField">weld / inspection-testing</descrip><descrip type="definition">Portion machined or cut from a test piece or test weld to a prescribed shape and size for one destructive test, such as a tensile, bend, impact or macro test.</descrip><admin type="source">ISO 15614-1 Specification and qualification of welding procedures for metallic materials — Welding procedure test — Part 1: Arc and gas welding of steels and arc welding of nickel and nickel alloys; JIS Z 3001-1:2018 溶接用語－第1部：一般</admin><langSec xml:lang="en"><termSec><term>test specimen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>specimen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>test sample</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>試験片</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>試験材</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「試験材」（日本語）、「시험재」（韓国語）、「Prüfstück」（ドイツ語）、「pieza de ensayo」（スペイン語）は試験片を採取する前の溶接試験材（test piece）を指し、規格上 test specimen とは区別される。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>试样</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>시험편</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>시험재</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「試験材」（日本語）、「시험재」（韓国語）、「Prüfstück」（ドイツ語）、「pieza de ensayo」（スペイン語）は試験片を採取する前の溶接試験材（test piece）を指し、規格上 test specimen とは区別される。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Probe</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Prüfprobe</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Prüfstück</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「試験材」（日本語）、「시험재」（韓国語）、「Prüfstück」（ドイツ語）、「pieza de ensayo」（スペイン語）は試験片を採取する前の溶接試験材（test piece）を指し、規格上 test specimen とは区別される。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>probeta</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>probeta de ensayo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>pieza de ensayo</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「試験材」（日本語）、「시험재」（韓国語）、「Prüfstück」（ドイツ語）、「pieza de ensayo」（スペイン語）は試験片を採取する前の溶接試験材（test piece）を指し、規格上 test specimen とは区別される。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02892"><descrip type="subjectField">weld / inspection-testing</descrip><descrip type="definition">Adjustable time window on the A-scan of an ultrasonic instrument within which echoes are monitored for amplitude or transit time, for example to trigger an alarm or record the signal.</descrip><admin type="source">ISO 5577 Non-destructive testing — Ultrasonic testing — Vocabulary</admin><langSec xml:lang="en"><termSec><term>gate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>evaluation gate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>monitor gate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>A-scan gate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>ゲート</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>闸门</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>栅极</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「Tor」（ドイツ語）は門・扉、「栅极」（中国語）はトランジスタや電子銃のグリッド電極を指し、超音波探傷器のゲートには使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>게이트</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Blende</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Tor</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「Tor」（ドイツ語）は門・扉、「栅极」（中国語）はトランジスタや電子銃のグリッド電極を指し、超音波探傷器のゲートには使わない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>puerta</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>compuerta</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-02955"><descrip type="subjectField">weld / inspection-testing</descrip><descrip type="definition">Penetrant containing a fluorescent dye that is inspected under UV-A light in a darkened area, giving higher sensitivity than a color contrast penetrant.</descrip><admin type="source">ISO 3452-1 Non-destructive testing — Penetrant testing — Part 1: General principles; JIS Z 2300 (非破壊試験用語)</admin><langSec xml:lang="en"><termSec><term>fluorescent penetrant</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>fluorescent liquid penetrant</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>fluorescent dye penetrant</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>蛍光浸透液</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>荧光渗透剂</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>荧光渗透液</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>형광 침투액</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>형광 침투제</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>fluoreszierendes Eindringmittel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>penetrante fluorescente</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03133"><descrip type="subjectField">weld / procedure-qualification</descrip><descrip type="definition">Any condition of a welding procedure, such as process, joint design, base and filler metal, position, preheat, PWHT, gas and electrical characteristics, that is recorded in a WPS or PQR and classed as essential, supplementary essential or nonessential.</descrip><admin type="source">AWS B2.1/B2.1M Specification for Welding Procedure and Performance Qualification</admin><langSec xml:lang="en"><termSec><term>welding variable</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>procedure variable</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>溶接確認項目</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>溶接変数</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>焊接工艺因素</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>용접 변수</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Einflussgröße</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schweißvariable</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>variable de soldeo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>variable de soldadura</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03175"><descrip type="subjectField">weld / procedure-qualification</descrip><descrip type="definition">Person who sets up, monitors and adjusts mechanized or automatic welding equipment during welding, qualified under ISO 14732 rather than as a manual welder under ISO 9606.</descrip><admin type="source">ISO 14732:2013 Welding personnel — Qualification testing of welding operators and weld setters for mechanized and automatic welding of metallic materials</admin><langSec xml:lang="en"><termSec><term>welding operator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>溶接オペレータ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>焊接操作工</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>焊工</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「焊工」（中国語）、「Schweißer」（ドイツ語）、「soldador」（スペイン語）は手溶接を行う溶接技能者（welder, ISO 9606）を指し、機械・自動溶接装置を操作する溶接オペレータ（ISO 14732）とは資格が異なる。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>자동 용접사</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>용접 오퍼레이터</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Schweißbediener</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Bediener von Schweißeinrichtungen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Schweißer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「焊工」（中国語）、「Schweißer」（ドイツ語）、「soldador」（スペイン語）は手溶接を行う溶接技能者（welder, ISO 9606）を指し、機械・自動溶接装置を操作する溶接オペレータ（ISO 14732）とは資格が異なる。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>operador de soldeo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>operador de soldadura</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>soldador</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「焊工」（中国語）、「Schweißer」（ドイツ語）、「soldador」（スペイン語）は手溶接を行う溶接技能者（welder, ISO 9606）を指し、機械・自動溶接装置を操作する溶接オペレータ（ISO 14732）とは資格が異なる。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03291"><descrip type="subjectField">weld / automation-fixturing</descrip><descrip type="definition">Shape of the path traced by the torch as it oscillates across the weld line, such as zigzag, triangular, circular or crescent, chosen in the robot's weaving settings.</descrip><admin type="source">J. N. Pires, A. Loureiro, G. Bölmsjo, Welding Robots: Technology, System Issues and Application, Springer (2006); Yaskawa Motoman — arc welding robot systems, public product documentation; Norrish, Advanced Welding Processes, Woodhead Publishing</admin><langSec xml:lang="en"><termSec><term>weaving pattern</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>weave pattern</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>ウィービングパターン</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>摆动模式</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>摆动方式</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>编织图案</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「编织图案」（中国語）、「Webmuster」（ドイツ語）、「patrón de tejido」（スペイン語）は織物の織り柄の意味で、溶接トーチの揺動パターンには使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>위빙 패턴</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Pendelform</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Pendelmuster</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Webmuster</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「编织图案」（中国語）、「Webmuster」（ドイツ語）、「patrón de tejido」（スペイン語）は織物の織り柄の意味で、溶接トーチの揺動パターンには使わない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>patrón de oscilación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>patrón de tejido</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「编织图案」（中国語）、「Webmuster」（ドイツ語）、「patrón de tejido」（スペイン語）は織物の織り柄の意味で、溶接トーチの揺動パターンには使わない。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03292"><descrip type="subjectField">weld / automation-fixturing</descrip><descrip type="definition">Lateral distance of the torch oscillation from the weld line during weaving, set as a length in the weaving conditions of a welding robot or oscillator.</descrip><admin type="source">J. N. Pires, A. Loureiro, G. Bölmsjo, Welding Robots: Technology, System Issues and Application, Springer (2006); JIS Z 3001-7:2018 4.3.2; Yaskawa Motoman — arc welding robot systems, public product documentation</admin><langSec xml:lang="en"><termSec><term>weaving amplitude</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>weave amplitude</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>ウィービング振幅</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>摆动幅度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>摆幅</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>编织幅度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「编织幅度」は中国語で織物の編み（weaving）の直訳で、溶接トーチの揺動（摆动）には使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>위빙 진폭</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Pendelamplitude</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>amplitud de oscilación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03306"><descrip type="subjectField">weld / automation-fixturing</descrip><descrip type="definition">Seam-tracking sensor that uses the change in welding current or voltage as the torch weaves across the groove to detect the joint position and correct the robot path, without a separate sensor head.</descrip><admin type="source">JIS Z 3001-1:2018 溶接用語—第1部：一般; Daihen (OTC) — welding robot systems, public catalog</admin><langSec xml:lang="en"><termSec><term>arc sensor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>through-arc seam tracking sensor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>アークセンサ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>アークセンサー</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="zh"><termSec><term>电弧传感器</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ko"><termSec><term>아크 센서</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="de"><termSec><term>Lichtbogensensor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>sensor de arco</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03394"><descrip type="subjectField">weld / adhesive-mechanical-joining</descrip><descrip type="definition">Boundary surface between the adhesive layer and an adherend in a bonded joint, where adhesion forces act and where adhesive failure occurs.</descrip><admin type="source">EN 923 Adhesives — Terms and definitions</admin><langSec xml:lang="en"><termSec><term>interface</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>adhesive interface</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>adhesive-adherend interface</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>接着界面</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>インターフェース</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「インターフェース」（中国語「接口」、韓国語「인터페이스」、ドイツ語「Schnittstelle」）はソフトウェア・電気機器の接続部の意味で、接着剤と被着材の境界面を指さない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>粘接界面</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>接口</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「インターフェース」（中国語「接口」、韓国語「인터페이스」、ドイツ語「Schnittstelle」）はソフトウェア・電気機器の接続部の意味で、接着剤と被着材の境界面を指さない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>접착 계면</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>인터페이스</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「インターフェース」（中国語「接口」、韓国語「인터페이스」、ドイツ語「Schnittstelle」）はソフトウェア・電気機器の接続部の意味で、接着剤と被着材の境界面を指さない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Grenzfläche</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Grenzfläche Klebstoff/Fügeteil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Schnittstelle</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「インターフェース」（中国語「接口」、韓国語「인터페이스」、ドイツ語「Schnittstelle」）はソフトウェア・電気機器の接続部の意味で、接着剤と被着材の境界面を指さない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>interfaz</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>interfaz adhesivo-sustrato</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03528"><descrip type="subjectField">weld / adhesive-mechanical-joining</descrip><descrip type="definition">Exposure of adhesive-bonded test joints to set laboratory conditions of heat, humidity, salt spray or immersion for a defined time before mechanical testing, to assess durability.</descrip><admin type="source">ISO 9142 Adhesives — Guide to the selection of standard laboratory ageing conditions for testing bonded joints</admin><langSec xml:lang="en"><termSec><term>ageing test</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>aging test</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>environmental ageing test</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>durability ageing</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>劣化試験</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>老化試験</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>エージング試験</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>時効試験</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「時効試験」（日本語）・「时效试验」（中国語）・「시효 시험」（韓国語）は鋼などの金属の時効（ひずみ時効など）を調べる試験で、接着継手の環境暴露による劣化試験とは別概念。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>老化试验</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>时效试验</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「時効試験」（日本語）・「时效试验」（中国語）・「시효 시험」（韓国語）は鋼などの金属の時効（ひずみ時効など）を調べる試験で、接着継手の環境暴露による劣化試験とは別概念。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>노화 시험</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>열화 시험</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>시효 시험</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「時効試験」（日本語）・「时效试验」（中国語）・「시효 시험」（韓国語）は鋼などの金属の時効（ひずみ時効など）を調べる試験で、接着継手の環境暴露による劣化試験とは別概念。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Alterungsprüfung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Auslagerungsprüfung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>ensayo de envejecimiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03685"><descrip type="subjectField">weld / safety-health</descrip><descrip type="definition">Heat load on a worker from the combination of hot air, radiant heat (for example from preheated parts or the arc), humidity, work rate and protective clothing, assessed with indices such as WBGT.</descrip><admin type="source">ISO 7243 Ergonomics of the thermal environment — Assessment of heat stress using the WBGT (wet bulb globe temperature) index</admin><langSec xml:lang="en"><termSec><term>heat stress</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>heat strain</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>熱ストレス</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>暑熱ストレス</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>熱応力</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「熱応力」（日本語）、「热应力」（中国語）、「열응력」（韓国語）、「Wärmespannung」（ドイツ語）、「tensión térmica」（スペイン語）は材料内部の温度差による応力（thermal stress）で、作業者の暑熱負荷には使わない。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>热应激</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>热负荷</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>热应力</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「熱応力」（日本語）、「热应力」（中国語）、「열응력」（韓国語）、「Wärmespannung」（ドイツ語）、「tensión térmica」（スペイン語）は材料内部の温度差による応力（thermal stress）で、作業者の暑熱負荷には使わない。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>열 스트레스</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>열응력</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「熱応力」（日本語）、「热应力」（中国語）、「열응력」（韓国語）、「Wärmespannung」（ドイツ語）、「tensión térmica」（スペイン語）は材料内部の温度差による応力（thermal stress）で、作業者の暑熱負荷には使わない。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Wärmebelastung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Hitzestress</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>Wärmespannung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「熱応力」（日本語）、「热应力」（中国語）、「열응력」（韓国語）、「Wärmespannung」（ドイツ語）、「tensión térmica」（スペイン語）は材料内部の温度差による応力（thermal stress）で、作業者の暑熱負荷には使わない。</note></termSec></langSec><langSec xml:lang="es"><termSec><term>estrés térmico</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>tensión térmica</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>「熱応力」（日本語）、「热应力」（中国語）、「열응력」（韓国語）、「Wärmespannung」（ドイツ語）、「tensión térmica」（スペイン語）は材料内部の温度差による応力（thermal stress）で、作業者の暑熱負荷には使わない。</note></termSec></langSec></conceptEntry>
<conceptEntry id="WELD-03810"><descrip type="subjectField">weld / safety-health</descrip><descrip type="definition">Air-purifying respirator that removes airborne particles such as welding fume through a filter, either with replaceable filters on a facepiece or as a filtering facepiece.</descrip><admin type="source">JIS T 8151 防じんマスク; 42 CFR Part 84 Approval of Respiratory Protective Devices</admin><langSec xml:lang="en"><termSec><term>particulate respirator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="ja"><termSec><term>防じんマスク</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>防塵マスク</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>防毒マスク</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「防毒マスク」、中国語の「防毒面具」、韓国語の「방독 마스크」は吸収缶で有害ガスを除去するマスクを指し、溶接ヒュームなどの粒子をろ過する防じんマスクとは別の保護具。</note></termSec></langSec><langSec xml:lang="zh"><termSec><term>防颗粒物呼吸器</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>防尘口罩</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>防毒面具</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「防毒マスク」、中国語の「防毒面具」、韓国語の「방독 마스크」は吸収缶で有害ガスを除去するマスクを指し、溶接ヒュームなどの粒子をろ過する防じんマスクとは別の保護具。</note></termSec></langSec><langSec xml:lang="ko"><termSec><term>방진 마스크</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>방진마스크</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec><termSec><term>방독 마스크</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote><note>日本語の「防毒マスク」、中国語の「防毒面具」、韓国語の「방독 마스크」は吸収缶で有害ガスを除去するマスクを指し、溶接ヒュームなどの粒子をろ過する防じんマスクとは別の保護具。</note></termSec></langSec><langSec xml:lang="de"><termSec><term>Partikelfiltergerät</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec><langSec xml:lang="es"><termSec><term>respirador para partículas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>equipo filtrante contra partículas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec></langSec></conceptEntry>
</body></text>
