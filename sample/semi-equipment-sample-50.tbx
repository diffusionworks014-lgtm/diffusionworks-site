<?xml version="1.0" encoding="UTF-8"?>
<tbx type="TBX-Basic" style="dca" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
<tbxHeader><fileDesc><sourceDesc><p>Diffusion Works — Semiconductor Equipment Termbase — evaluation sample (50 terms). Non-commercial evaluation use only.</p></sourceDesc></fileDesc></tbxHeader>
<text><body>
<conceptEntry id="s001"><descrip type="definition">A bearing in which a thin film of pressurized air separates the moving element from its guide surface, giving frictionless, wear-free motion with very low vibration. Wafer and reticle stages and precision spindles use it, often with vacuum preload, where mechanical bearings would add friction, particles or hysteresis.</descrip><admin type="source">A. H. Slocum, Precision Machine Design (Prentice Hall, 1992); Wikipedia: Air bearing</admin>
<langSec xml:lang="en"><termSec><term>air bearing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>エアベアリング</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>空気ベアリング</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>气浮轴承</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>空气承载</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>에어 베어링</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>공기 지지대</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Luftlager</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>cojinete de aire</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>rodamiento de aire</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s002"><descrip type="definition">A thin-film deposition method in which two or more precursor gases are pulsed alternately into the chamber, each reacting with the surface in a self-limiting way so that film grows roughly one atomic layer per cycle. It gives precise thickness control and conformal coverage in high-aspect-ratio structures.</descrip><admin type="source">S. M. George, Atomic Layer Deposition: An Overview, Chem. Rev. 110, 111 (2010); SEMI International Standards: Compilation of Terms; Wikipedia: Atomic layer deposition</admin>
<langSec xml:lang="en"><termSec><term>atomic layer deposition</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ALD</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>原子層堆積</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>原子層蒸着</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>原子層沈着</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>原子層付着</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>原子层沉积</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>原子层蒸镀</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>원자층 증착</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>원자층 침전</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Atomlagenabscheidung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Atomschichtablagerung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>deposición de capas atómicas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>sedimentación de capas atómicas</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s003"><descrip type="definition">The fab-wide system of overhead transport vehicles, stockers, conveyors and control software that moves wafer carriers between tools and storage without manual handling. It covers both interbay and intrabay transport.</descrip><admin type="source">SEMI E153 — Specification for AMHS SEM (AMHS SEM)</admin>
<langSec xml:lang="en"><termSec><term>automated material handling system</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>AMHS</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>自動搬送システム</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>自動材料処理システム</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>自動材料取扱システム</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>自动物料搬运系统</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>自动材料处理系统</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>자동 반송 시스템</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>automatisiertes Materialtransportsystem</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>sistema automatizado de manejo de materiales</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s004"><descrip type="definition">Measuring the ion beam current, usually with a Faraday cup in the beamline or end station, to integrate charge and control implanted dose. Secondary-electron suppression and neutral-beam compensation are needed so that the reading equals the true ion current reaching the wafer.</descrip><admin type="source">S. Wolf and R. N. Tauber, Silicon Processing for the VLSI Era, Vol. 1: Process Technology, 2nd ed., Lattice Press (2000); Wikipedia: Faraday cup</admin>
<langSec xml:lang="en"><termSec><term>beam current measurement</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>ビーム電流測定</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>光線電流測定</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ビーム電流量測定</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>束流测量</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>光束电流测量</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>빔 전류 측정</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>광선 전류 측정</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Strahlstrommessung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>medición de la corriente del haz</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s005"><descrip type="definition">Penetration of implanted ions far deeper than expected when the beam is aligned with a low-index crystal direction and ions travel between atomic rows with few collisions. Implanters tilt and twist the wafer, or use a screen oxide, to randomize incidence and keep the junction depth predictable.</descrip><admin type="source">S. Wolf and R. N. Tauber, Silicon Processing for the VLSI Era, Vol. 1: Process Technology, 2nd ed., Lattice Press (2000); Wikipedia: Channelling (physics)</admin>
<langSec xml:lang="en"><termSec><term>channeling</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>チャネリング</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>溝加工</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>水路化</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>経路形成</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>沟道效应</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>槽道化</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>沟槽加工</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>채널링</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>채널 가공</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Channeling</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Kanalisierung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>canalización</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s006"><descrip type="definition">Growth of a solid film on a heated substrate from gaseous precursors that react or decompose at or near the surface, with by-products carried away by the exhaust. Thermal, plasma-enhanced and low-pressure variants are used for dielectrics, polysilicon and metals.</descrip><admin type="source">SEMI M59 — Terminology for Silicon Technology; H. O. Pierson, Handbook of Chemical Vapor Deposition, 2nd ed. (Noyes, 1999); Wikipedia: Chemical vapor deposition</admin>
<langSec xml:lang="en"><termSec><term>chemical vapor deposition</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>CVD</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>化学気相成長</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>化学蒸気堆積</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>化学的蒸気析出</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>化学气相沉积</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>化学蒸汽沉积</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>화학 기상 증착</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>화학 증기 침전</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>chemische Gasphasenabscheidung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>chemische Dampfablagerung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>deposición química de vapor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>deposición de vapor químico</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s007"><descrip type="definition">The angle between the surface of a liquid droplet and the solid surface it rests on, measured through the liquid. On wafers it quantifies how hydrophilic or hydrophobic a surface is after cleaning and predicts watermark and drying behavior.</descrip><admin type="source">ISO 19403-2 — Paints and varnishes — Wettability — Part 2: Determination of the surface free energy of solid surfaces by measuring the contact angle; K. A. Reinhardt &amp; W. Kern (eds.), Handbook of Silicon Wafer Cleaning Technology, 3rd ed. (William Andrew, 2018); Wikipedia: Contact angle</admin>
<langSec xml:lang="en"><termSec><term>contact angle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>接触角</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>接点角</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>触角</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>接触角</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>触角</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>접촉각</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>접점각</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Kontaktwinkel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Berührungswinkel</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>ángulo de contacto</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s008"><descrip type="definition">Unintended transfer of chemical species, particles or metallic impurities from one wafer, bath or chamber to another, for example when wafers from different process steps share a cleaning bath. Tool dedication and recipe segregation are used to prevent it.</descrip><admin type="source">W. Kern (ed.), Handbook of Semiconductor Wafer Cleaning Technology (Noyes, 1993); K. A. Reinhardt &amp; W. Kern (eds.), Handbook of Silicon Wafer Cleaning Technology, 3rd ed. (William Andrew, 2018)</admin>
<langSec xml:lang="en"><termSec><term>cross-contamination</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>クロスコンタミネーション</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>二次汚染</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>交叉污染</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>互相污染</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>교차 오염</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>상호 오염</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Kreuzkontamination</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Überkreuzverschmutzung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>contaminación cruzada</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>contaminación mutua</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s009"><descrip type="definition">The crystallographic direction of a single-crystal wafer surface normal, such as (100) or (111), together with the azimuthal reference given by the notch or flat. It determines etch behaviour, oxidation rate, carrier mobility and cleavage, and is checked by X-ray or optical methods.</descrip><admin type="source">SEMI MF26 — Test Method for Determining the Orientation of a Semiconductive Single Crystal</admin>
<langSec xml:lang="en"><termSec><term>crystal orientation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>結晶方位</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>結晶方向</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>結晶配向</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>結晶の向き</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>水晶方位</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>晶向</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>水晶方向</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>晶体朝向</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>结晶方位</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>결정 방향</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>수정 방향</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>크리스탈 방향</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>결정 지향</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Kristallorientierung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Kristallausrichtung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Quarzorientierung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Kristalllage</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>orientación cristalina</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>dirección del cristal</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>orientación de cuarzo</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>alineación cristalina</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s010"><descrip type="definition">A plot of the positions of detected defects across a wafer, generated by an inspection tool, with each defect classified by size or type. Engineers compare maps across process steps to find where defects were added and to recognize signatures such as scratches or arc patterns.</descrip><admin type="source">SEMI M35 — Guide for Developing Specifications for Silicon Wafer Surface Features Detected by Automated Inspection</admin>
<langSec xml:lang="en"><termSec><term>defect map</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>欠陥マップ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>欠陥地図</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>缺陷图</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>瑕疵地图</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>디펙트 맵</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Defect Map</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Fehlerlandkarte</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>mapa de defectos</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s011"><descrip type="definition">Recess of a soft or fast-polishing feature, such as a copper line or pad, below the surrounding harder surface after CMP, leaving a shallow dish-shaped depression. It is measured together with erosion to characterize planarization quality.</descrip><admin type="source">J. M. Steigerwald, S. P. Murarka &amp; R. J. Gutmann, Chemical Mechanical Planarization of Microelectronic Materials (Wiley, 1997)</admin>
<langSec xml:lang="en"><termSec><term>dishing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>ディッシング</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>皿状化</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>皿盛り</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>凹み</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>碟形凹陷</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>蝶形凹陷</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>盘状化</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>디싱</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>접시형 함몰</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Dishing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schüsselbildung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>dishing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>plato</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s012"><descrip type="definition">The second stage of a two-step diffusion in which a wafer that already carries a shallow predeposited dopant layer is heated, usually in an oxidising or inert ambient, so that the dopant redistributes deeper into the silicon to the target junction depth. It sets the final profile without adding more dopant.</descrip><admin type="source">J. D. Plummer, M. D. Deal &amp; P. B. Griffin, Silicon VLSI Technology: Fundamentals, Practice and Modeling (Prentice Hall, 2000); Wikipedia: Diffusion (semiconductor)</admin>
<langSec xml:lang="en"><termSec><term>drive-in</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>ドライブイン</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>乗り入れ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>運転投入</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ドライブ・イン方式</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>推进扩散</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>驾入</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>开进</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>驾车进入</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>드라이브인</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>차량 진입</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>운전 투입</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>드라이브 인 매장</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Drive-in</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Einfahrt</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Hineinfahren</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Autokino</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>drive-in</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>autocine</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>conducción interna</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>entrada de vehículos</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s013"><descrip type="definition">Measurement of electrical parameters on test structures or devices on a wafer to confirm that the process has produced the intended transistor and interconnect characteristics. In a fab it is run on wafers at defined points of the flow, often at the end, to accept or reject lots.</descrip><admin type="source">G. S. May &amp; C. J. Spanos, Fundamentals of Semiconductor Manufacturing and Process Control (Wiley, 2006)</admin>
<langSec xml:lang="en"><termSec><term>electrical test</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>e-test</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>電気特性試験</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>耐電圧試験</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>電気安全試験</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>電力試験</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>电性测试</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>电力测试</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>电气安全测试</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>전기 특성 테스트</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>내전압 시험</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>전기 안전 시험</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>전력 테스트</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>elektrischer Test</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Stromtest</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>elektrische Sicherheitsprüfung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>prueba eléctrica</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>prueba de potencia</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>prueba de seguridad eléctrica</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s014"><descrip type="definition">A hard-wired button and circuit that removes hazardous power from a tool at once, independently of the control software. It is the last-resort cut-off defined for cluster tools and fab equipment, distinct from a controlled emergency stop.</descrip><admin type="source">SEMI E20 — Cluster Tool Module Interface: Electrical Power and Emergency Off Standard; SEMI S2 — Environmental, Health, and Safety Guideline for Semiconductor Manufacturing Equipment</admin>
<langSec xml:lang="en"><termSec><term>emergency off</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>EMO</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>EMO</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>非常停止</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>紧急关断</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>紧急停止</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>EMO</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>비상정지</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Not-Aus</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Not-Halt</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>desconexión de emergencia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>parada de emergencia</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s015"><descrip type="definition">Drawing ions out of the ion source plasma through a slit and forming them into a beam with electrodes held at high potential relative to the source. The extraction voltage and electrode geometry set the initial beam energy and the current an implanter can deliver.</descrip><admin type="source">S. Wolf and R. N. Tauber, Silicon Processing for the VLSI Era, Vol. 1: Process Technology, 2nd ed., Lattice Press (2000); J. F. Ziegler (ed.), Ion Implantation: Science and Technology, 2nd ed., Academic Press (1988); Wikipedia: Ion source</admin>
<langSec xml:lang="en"><termSec><term>extraction</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>引き出し</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>抽出</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>摘出</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>取り出し</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>引出</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>提取</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>抽取</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>인출</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>추출</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Extraktion</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>extracción</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s016"><descrip type="definition">Continuous sensing of hazardous gas concentration at points such as gas cabinets, valve manifold boxes and tool enclosures, with alarms and interlocks that cut off supply when a leak is found. It is a core requirement of equipment safety design for toxic, flammable and corrosive gases.</descrip><admin type="source">SEMI S2 — Environmental, Health, and Safety Guideline for Semiconductor Manufacturing Equipment</admin>
<langSec xml:lang="en"><termSec><term>gas detection</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>ガス検知</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ガス探査</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ガス発見</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>气体检测</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>气体发现</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>가스 감지</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Gasdetektion</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>detección de gases</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s017"><descrip type="definition">A liquid chemical refined to semiconductor-grade limits on metallic, particulate and anionic contamination, used for wafer cleaning, etching and resist processing. Its purity grade sets the materials and cleanliness required of the delivery and dispense system.</descrip><admin type="source">SEMI C1 — Guide for the Analysis of Liquid Chemicals; SEMI F57 — Specification for High Purity Polymer Materials and Components Used in Ultrapure Water and Liquid Chemical Distribution Systems</admin>
<langSec xml:lang="en"><termSec><term>high-purity chemical</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>高純度薬品</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>高純度化学物質</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>高純度薬剤</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>高纯化学品</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>高纯化学物质</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>고순도 화학약품</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>hochreine Chemikalie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>químico de alta pureza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s018"><descrip type="definition">A reliability stress test in which packaged devices are operated under bias at elevated ambient temperature for an extended time, typically 1000 hours, to accelerate wear-out and infant mortality failure mechanisms. Results are used to project field lifetime.</descrip><admin type="source">JEDEC JESD22-A108 — Temperature, Bias, and Operating Life</admin>
<langSec xml:lang="en"><termSec><term>high-temperature operating life</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>HTOL</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>高温動作寿命試験</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>高温運転寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>高温操作寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>高温作動生活</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>高温工作寿命试验</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>高温运行寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>高温操作寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>高温经营寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>고온 동작 수명 시험</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>고온 운전 수명</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>고온 작업 생활</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>고온 조작 수명</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Hochtemperatur-Betriebslebensdauertest</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Hochtemperatur-Betriebsleben</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Hochtemperatur-Operationsleben</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>prueba de vida operativa a alta temperatura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>vida de operación de alta temperatura</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>prueba de vida de funcionamiento caliente</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s019"><descrip type="definition">The number of particles in a slurry above a size threshold, typically around 0.5 to 1 micrometer, that is far larger than the mean abrasive size, measured by single-particle optical sensing. It is tracked because these oversized particles correlate with scratch defects.</descrip><admin type="source">SEMI C98 — Guide for Chemical Mechanical Planarization (CMP) Particle Size Distribution (PSD) Measurement and Reporting Used in Semiconductor Manufacturing</admin>
<langSec xml:lang="en"><termSec><term>large particle count</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>LPC</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>粗大粒子数</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>大規模粒子数</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>大量粒子数</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>大颗粒计数</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>大量颗粒计数</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>대형 입자 수</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>대량 입자 수</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Grobpartikelanzahl</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>große Partikelzählung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>recuento de partículas grandes</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>gran conteo de partículas</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s020"><descrip type="definition">The electrode in a parallel-plate plasma chamber on which the wafer rests, usually integrated with the electrostatic chuck and temperature control. In RIE tools it carries the RF bias that accelerates ions toward the wafer.</descrip><admin type="source">K. Nojiri, Dry Etching Technology for Semiconductors, Springer (2015); M. A. Lieberman and A. J. Lichtenberg, Principles of Plasma Discharges and Materials Processing, 2nd ed., Wiley (2005); Wikipedia: Reactive-ion etching</admin>
<langSec xml:lang="en"><termSec><term>lower electrode</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>下部電極</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>低電極</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>下方電極</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>下电极</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>低电极</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>하부 전극</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>낮은 전극</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>untere Elektrode</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>niedrige Elektrode</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>electrodo inferior</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>electrodo bajo</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s021"><descrip type="definition">A tunable reactive circuit placed between an RF generator and a plasma load so that the load impedance seen by the generator stays at 50 ohm and reflected power is minimised. In production tools it is an automatically tuned unit mounted close to the chamber electrode.</descrip><admin type="source">SEMI E113 — Specification for Semiconductor Processing Equipment RF Power Delivery Systems</admin>
<langSec xml:lang="en"><termSec><term>matching network</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>マッチングボックス</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>整合ネットワーク</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>一致回路</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>適合回路</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>マッチング網</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>阻抗匹配器</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>配对网络</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>一致网络</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>匹配网路</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>매처</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>일치 네트워크</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>정합 망</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>매칭 회로망</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Anpassnetzwerk</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Übereinstimmungsnetzwerk</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Passungsnetzwerk</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>red de adaptación de impedancia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>red de coincidencia</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>red de emparejamiento</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>red de ajuste</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s022"><descrip type="definition">The average time an excess electron or hole survives in a semiconductor before recombining, which reflects the density of recombination centers such as metallic contamination. It is measured contactlessly on wafers, for example by photoconductance decay or microwave reflection, to monitor cleanliness of furnaces and wet benches.</descrip><admin type="source">SEMI MF28 — Test Method for Minority Carrier Lifetime in Bulk Germanium and Silicon by Measurement of Photoconductivity Decay</admin>
<langSec xml:lang="en"><termSec><term>minority carrier lifetime</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>少数キャリアライフタイム</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>少数キャリア生存時間</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>マイノリティキャリア寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>少数载流子寿命</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>少数载体寿命</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>소수 캐리어 수명</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>소수 운송자 수명</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Minoritätsladungsträgerlebensdauer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Minderheitsträgerlebensdauer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>tiempo de vida de portadores minoritarios</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>vida de transportadores minoritarios</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s023"><descrip type="definition">A pattern placed off its intended position relative to an earlier layer because the exposure tool's alignment to the wafer marks was wrong or the marks were damaged. It appears as a systematic overlay error and can cause shorts or opens where layers must connect.</descrip><admin type="source">SEMI P35 — Terminology for Microlithography Metrology</admin>
<langSec xml:lang="en"><termSec><term>misalignment</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>合わせずれ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>不整列</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>誤整合</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>整合不良</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>对准偏差</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>不对齐</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>미스얼라인</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>비정렬</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Fehljustage</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>desalineación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s024"><descrip type="definition">The spontaneous release of gas, mainly water vapour and solvents, from the surfaces and bulk of materials inside a vacuum system after pump-down. It sets the ultimate pressure and pump-down time of a chamber and drives the choice of materials, bake-out and purge practice.</descrip><admin type="source">ISO 3529-1 — Vacuum technology — Vocabulary — Part 1: General terms</admin>
<langSec xml:lang="en"><termSec><term>outgassing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>アウトガス</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>排ガス</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ガス抜き</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>出ガス</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ガス漏れ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>放气</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>排气</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>废气</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>漏气</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>除气</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>아웃개싱</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>배기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>배기 가스</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>가스 배출</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>가스 누출</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Ausgasung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Abgas</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Entlüftung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Ausdünstung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Gasaustritt</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>desgasificación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>escape de gases</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>gases de escape</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>fuga de gas</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ventilación</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s025"><descrip type="definition">The RF power an RF generator delivers at its output connector, normally stated as forward power into a matched 50 ohm load. It is the quantity that the generator setpoint, readback and SEMI E136 test method refer to.</descrip><admin type="source">SEMI E136 — Test Method for Determining the Output Power of RF Generators Used in Semiconductor Processing Equipment RF Power Delivery Systems</admin>
<langSec xml:lang="en"><termSec><term>output power</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>出力電力</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>出力動力</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>出力電源</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>出力エネルギー</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>输出功率</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>输出电源</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>输出动力</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>输出能量</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>출력 전력</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>출력 동력</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>출력 전원</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>출력 에너지</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Ausgangsleistung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Ausgangskraft</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Ausgangsenergie</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Ausgangsstrom</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>potencia de salida</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>poder de salida</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>energía de salida</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>fuerza de salida</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s026"><descrip type="definition">The positional offset between a pattern printed in the current layer and the pattern of a reference layer, measured at overlay marks and reported as x and y vectors across the wafer. It is budgeted per layer pair and corrected through exposure-tool alignment corrections.</descrip><admin type="source">SEMI P35 — Terminology for Microlithography Metrology; SEMI P28 — Specification for Overlay-Metrology Test Patterns for Integrated-Circuit Manufacture</admin>
<langSec xml:lang="en"><termSec><term>overlay error</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>オーバーレイ誤差</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>重複誤差</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>覆い誤差</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>上塗り誤差</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>套刻误差</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>覆盖误差</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>重叠误差</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>오버레이 오차</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Overlay-Fehler</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>error de overlay</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s027"><descrip type="definition">A planar crystal defect that nucleates at surface or near-surface damage and grows during thermal oxidation of a silicon wafer, visible after preferential etching as a short line defect. Its density is used as a wafer quality and process cleanliness indicator.</descrip><admin type="source">SEMI MF1727 — Practice for Detection of Oxidation Induced Defects in Polished Silicon Wafers</admin>
<langSec xml:lang="en"><termSec><term>oxidation-induced stacking fault</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>OSF</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>酸化誘起積層欠陥</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>酸化誘導積層欠陥</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>酸化誘発積み重ね欠陥</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>積層故障</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>氧化诱生层错</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>氧化诱发堆叠故障</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>氧化引起的堆垛错误</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>氧化堆积故障</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>산화 유기 적층 결함</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>산화 유도 적층 고장</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>산화 적층 오류</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>oxidationsinduzierter Stapelfehler</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Stapelstörung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Oxidationsstapelfehlfunktion</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>falla de apilamiento inducida por oxidación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>avería de apilamiento</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>fallo de apilado por oxidación</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>error de apilamiento</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s028"><descrip type="definition">The resistance of a CMP polishing pad to indentation, usually reported on the Shore D or Shore A scale. Harder pads planarize better and softer pads reduce scratching, so it is a key consumable specification.</descrip><admin type="source">SEMI C100 — Guide for Reporting Chemical Mechanical Planarization (CMP) Polishing Pads Hardness Used in Semiconductor Manufacturing</admin>
<langSec xml:lang="en"><termSec><term>pad hardness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>パッド硬度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>パッド剛性</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>パッド強度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>抛光垫硬度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>抛光垫刚度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>패드 경도</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>패드 강도</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Padhärte</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Padsteifigkeit</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>dureza del pad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>rigidez del pad</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s029"><descrip type="definition">A discrete piece of solid or liquid matter on a wafer surface or in a gas, liquid or air stream, small enough to be counted individually and large enough to cause a defect. Equipment is specified by the number of particles it adds to a wafer.</descrip><admin type="source">SEMI M59 — Terminology for Silicon Technology; SEMI M35 — Guide for Developing Specifications for Silicon Wafer Surface Features Detected by Automated Inspection; ISO 14644-1 — Cleanrooms and associated controlled environments — Part 1: Classification of air cleanliness by particle concentration</admin>
<langSec xml:lang="en"><termSec><term>particle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>パーティクル</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>粒</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ほこり</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>粒子状物質</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>颗粒</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>灰尘</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>尘埃</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>파티클</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>먼지</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Partikel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Staub</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Korn</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>partícula</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>polvo</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s030"><descrip type="definition">The number of airborne particles at or above a given size per unit volume of air, the quantity by which cleanroom air cleanliness classes are defined. It is measured with a discrete particle counter at specified sampling locations.</descrip><admin type="source">ISO 14644-1 — Cleanrooms and associated controlled environments — Part 1: Classification of air cleanliness by particle concentration</admin>
<langSec xml:lang="en"><termSec><term>particle concentration</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>粒子濃度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>粒子集中</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>粒子密度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>粒子浓度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>粒子集中度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>입자 농도</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>입자 집중</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Partikelkonzentration</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Partikeldichte</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>concentración de partículas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>densidad de partículas</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s031"><descrip type="definition">A defect caused by a foreign particle that lands on the wafer during deposition or another process step and is then buried in or shadows the growing film, leaving a bump, pinhole or void in the pattern. Inspection systems classify it separately from pattern and process-induced defects.</descrip><admin type="source">SEMI International Standards: Compilation of Terms</admin>
<langSec xml:lang="en"><termSec><term>particle defect</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>パーティクル欠陥</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>粒子欠点</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>微粒子不良</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>颗粒缺陷</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>颗粒缺点</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>파티클 결함</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>입자 결점</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Partikeldefekt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>defecto por partícula</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s032"><descrip type="definition">Toppling or sticking together of adjacent high-aspect-ratio resist lines, driven by capillary forces as the rinse liquid dries after development. It limits how narrow and tall resist features can be printed and is countered with surfactant rinses or low-surface-tension drying.</descrip><admin type="source">C. A. Mack, Fundamental Principles of Optical Lithography (Wiley, 2007)</admin>
<langSec xml:lang="en"><termSec><term>pattern collapse</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>パターン倒れ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>パターン崩壊</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>图形坍塌</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>模式崩溃</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>패턴 붕괴</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>무늬 붕괴</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Pattern Collapse</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Musterzusammenbruch</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>colapso de patrón</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>colapso del modelo</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s033"><descrip type="definition">Clothing and devices worn by a worker, such as chemical-resistant gloves, goggles, face shields and respirators, to protect against hazards that remain after engineering controls. Equipment safety documents state what is required for each maintenance task.</descrip><admin type="source">SEMI S21 — Safety Guideline for Worker Protection</admin>
<langSec xml:lang="en"><termSec><term>personal protective equipment</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>PPE</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>個人用保護具</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>個人保護装置</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>個人的防護装備</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>个人防护装备</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>个人保护设备</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>개인보호구</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>개인 방어 장비</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>persönliche Schutzausrüstung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>persönliche Schutzeinrichtung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>equipo de protección individual</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s034"><descrip type="definition">Resist material left on the wafer after stripping or ashing, often as a hardened crust or thin scum produced by etch or implant exposure. It is removed by additional plasma or wet clean steps because it causes defects and blocks later processing.</descrip><admin type="source">S. Wolf and R. N. Tauber, Silicon Processing for the VLSI Era, Vol. 1: Process Technology, 2nd ed., Lattice Press (2000); Wikipedia: Plasma ashing</admin>
<langSec xml:lang="en"><termSec><term>photoresist residue</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>レジスト残渣</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>感光剤残留物</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>フォトレジスト残り物</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>光刻胶残留</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>感光剂残留</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>PR 잔사</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Fotolackrückstand</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>residuo de fotorresina</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s035"><descrip type="definition">A tiny hole through a thin film or resist layer, caused by a particle, bubble or local non-wetting, that exposes the layer beneath. Pinholes in dielectrics cause leakage or shorts and in resist lead to unwanted etching, so films are screened for pinhole density.</descrip><admin type="source">SEMI M59 — Terminology for Silicon Technology</admin>
<langSec xml:lang="en"><termSec><term>pinhole</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>ピンホール</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>針穴</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ピン穴</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>针孔</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>别针孔</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>핀홀</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>바늘 구멍</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Pinhole</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Stecknadelloch</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>pinhole</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>agujero de pin</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s036"><descrip type="definition">Removal of photoresist by exposing the wafer to an oxygen-based plasma that oxidizes the organic film into volatile gases. It is performed in a dedicated asher or in the etch chamber as a dry alternative to wet stripping.</descrip><admin type="source">S. Wolf and R. N. Tauber, Silicon Processing for the VLSI Era, Vol. 1: Process Technology, 2nd ed., Lattice Press (2000); K. Nojiri, Dry Etching Technology for Semiconductors, Springer (2015); Wikipedia: Plasma ashing</admin>
<langSec xml:lang="en"><termSec><term>plasma ashing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>アッシング</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>プラズマ灰化処理</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>焼却</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>等离子去胶</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>等离子烧灰</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>애싱</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>회화</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Plasmaveraschung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>ashing por plasma</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>incineración por plasma</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s037"><descrip type="definition">The scheduled interval, in time, wafer count or RF hours, between successive preventive maintenance events on a tool or module. Extending it without raising unscheduled downtime is a common equipment-engineering goal, since PM time counts against availability.</descrip><admin type="source">SEMI E10 — Specification for Definition and Measurement of Equipment Reliability, Availability, and Maintainability (RAM) and Utilization</admin>
<langSec xml:lang="en"><termSec><term>PM cycle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>PM周期</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>予防保全循環</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>PM周期</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>预防维护循环</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>PM 주기</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>예방 보전 순환</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>PM-Zyklus</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>vorbeugender Wartungskreislauf</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>ciclo de PM</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>círculo de mantenimiento</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s038"><descrip type="definition">A single-crystal wafer whose front surface, and often back surface, has been chemically-mechanically polished to a mirror finish after slicing, lapping and etching, ready for device fabrication or epitaxy. It is the standard starting substrate specified by SEMI M1.</descrip><admin type="source">SEMI M1 — Specification for Polished Single Crystal Silicon Wafers</admin>
<langSec xml:lang="en"><termSec><term>polished wafer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>PW</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>鏡面ウェーハ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>磨かれたウェハ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>光沢ウェハ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>研削ウェハ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>洗練されたウェハ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>抛光片</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>打磨晶圆</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>磨光片</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>光亮片</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>研磨片</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>폴리시드 웨이퍼</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>광택 웨이퍼</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>세련된 웨이퍼</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>연삭 웨이퍼</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>polierter Wafer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>geschliffener Wafer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>glänzender Wafer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>raffinierter Wafer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>oblea pulida</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>oblea lustrada</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>oblea esmerilada</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>oblea refinada</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s039"><descrip type="definition">The maximum deviation between the commanded and the actually reached position of a motion axis over its travel, normally stated together with repeatability. Equipment specifications quote it for stages, robots and aligners to show how closely a target coordinate can be hit.</descrip><admin type="source">ISO 230-2 — Test code for machine tools — Part 2: Determination of accuracy and repeatability of positioning of numerically controlled axes</admin>
<langSec xml:lang="en"><termSec><term>positioning accuracy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>位置決め精度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>配置精度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>ポジショニング正確さ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>定位精度</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>放置精度</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>위치 결정 정밀도</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>배치 정밀도</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Positioniergenauigkeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Platzierungsgenauigkeit</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>precisión de posicionamiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>precisión de colocación</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s040"><descrip type="definition">The target RF power value commanded to a generator by the tool controller or recipe, against which the generator regulates its actual output. Readback and alarms are judged relative to it.</descrip><admin type="source">SEMI E113 — Specification for Semiconductor Processing Equipment RF Power Delivery Systems</admin>
<langSec xml:lang="en"><termSec><term>power setpoint</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>電力設定値</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>電力設定点</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>パワー設定ポイント</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>電源設定値</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>功率设定值</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>电源设定值</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>功率设置点</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>动力设定值</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>전력 설정값</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>전력 설정점</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>전원 설정값</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>동력 설정값</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Leistungssollwert</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Leistungseinstellpunkt</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Leistungssetzpunkt</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>consigna de potencia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>punto fijo de potencia</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>punto de potencia</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>consigna de poder</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s041"><descrip type="definition">The difference in static air pressure between two adjacent spaces, such as a cleanroom and its corridor or a minienvironment and the surrounding bay, maintained so that air leaks from the cleaner to the less clean side. It is monitored as a basic contamination-control parameter.</descrip><admin type="source">ISO 14644-4 — Cleanrooms and associated controlled environments — Part 4: Design, construction and start-up; ISO 14644-3 — Cleanrooms and associated controlled environments — Part 3: Test methods</admin>
<langSec xml:lang="en"><termSec><term>pressure differential</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>差圧</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>圧力差分</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>示差圧力</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>压差</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>压力微分</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>차압</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>압력 미분</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Differenzdruck</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Differentialdruck</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>presión diferencial</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s042"><descrip type="definition">Inert gas, usually nitrogen or argon, flowed through lines, chambers or enclosures to displace air, moisture or residual process gas before and after operation. It keeps high-purity gas lines clean and dilutes hazardous residues during maintenance.</descrip><admin type="source">SEMI E49.8 — Guide for High Purity Gas Distribution Systems</admin>
<langSec xml:lang="en"><termSec><term>purge gas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>パージガス</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>掃気ガス</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>洗浄ガス</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>吹扫气体</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>清洗气体</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>퍼지 가스</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>세정 가스</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Spülgas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Reinigungsgas</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>gas de purga</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>gas de limpieza</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s043"><descrip type="definition">A small quadrupole mass spectrometer mounted on a vacuum chamber to identify the gas species present and their partial pressures, used for leak checking, contamination and water-vapour monitoring and process endpoint. It operates only at high vacuum, so a differentially pumped inlet is used on process chambers.</descrip><admin type="source">ISO 14291:2012 — Vacuum gauges — Definitions and specifications for quadrupole mass spectrometers</admin>
<langSec xml:lang="en"><termSec><term>residual gas analyzer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>RGA</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>残留ガス分析計</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>残余ガス分析器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>残りガス分析装置</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>残留気体解析器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>残余气体分析仪</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>剩余气体分析器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>残留气体解析仪</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>余气分析仪</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>잔류 가스 분석기</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>잔여 가스 분석기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>나머지 가스 분석기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>잔류 가스 해석기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Restgasanalysator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Rückstandsgasanalysator</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Restgasanalyzer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Übriggasanalysator</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>analizador de gases residuales</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>analizador de gas remanente</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>analizador de gases restantes</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s044"><descrip type="definition">An advanced process control method that adjusts recipe setpoints between successive runs or lots using metrology results from earlier runs. It compensates slow drifts such as consumable wear without changing settings inside a run.</descrip><admin type="source">SEMI E133 — Specification for Automated Process Control Systems Interface</admin>
<langSec xml:lang="en"><termSec><term>run-to-run control</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>R2R</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>R2R制御</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>連続運転制御</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>実行間制御</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>批间控制</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>运行到运行控制</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>R2R 제어</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>실행 간 제어</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Run-to-Run-Regelung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Lauf-zu-Lauf-Steuerung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>control run-to-run</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>control de ejecución a ejecución</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s045"><descrip type="definition">An electric motor combined with a position or speed feedback device and a drive that closes the control loop so the shaft follows commanded position, velocity and torque profiles. Equipment axes such as robot arms, stages and lifts use it where precise, repeatable motion is required.</descrip><admin type="source">NEMA ICS 16 — Industrial Control and Systems: Motion/Position Control Motors, Controls, and Feedback Devices; Wikipedia: Servomotor</admin>
<langSec xml:lang="en"><termSec><term>servo motor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>サーボモータ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>従動モータ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>追従モータ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>伺服电机</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>服务电机</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>서보 모터</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Servomotor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>servomotor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>motor de servicio</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s046"><descrip type="definition">A test that dips package leads or terminations into molten solder after accelerated aging and inspects the wetted area to confirm that the surface finish will solder reliably at board assembly. JEDEC JESD22-B102 specifies the procedure for IC packages.</descrip><admin type="source">JEDEC JESD22-B102 — Solderability</admin>
<langSec xml:lang="en"><termSec><term>solderability test</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>はんだ付け性試験</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>溶接性試験</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>可焊性测试</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>焊接性测试</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>솔더링성 시험</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>용접성 시험</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Lötbarkeitsprüfung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Schweißbarkeitsprüfung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>ensayo de soldabilidad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s047"><descrip type="definition">A package that integrates several dies and often passive components, stacked or placed side by side on a substrate, so that the package itself delivers a complete functional system. It contrasts with a system on chip, where all functions sit on one die.</descrip><admin type="source">IEEE EPS Heterogeneous Integration Roadmap (2021 ed.), Chapter 21: SiP and Module System Integration; Wikipedia: System in a package</admin>
<langSec xml:lang="en"><termSec><term>system in package</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>SiP</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>SiP</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>パッケージ内システム</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>一体化パッケージ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>系统级封装</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>封装内系统</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>SiP</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>System-in-Package</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>system in package</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s048"><descrip type="definition">The automatic test equipment that applies stimulus to a device under test and measures its response according to a test program, deciding pass, fail and bin. In a test cell it is coupled to a prober or a handler that presents the devices.</descrip><admin type="source">SEMI E122 — Specification for Tester Equipment Specific Equipment Model (TSEM); M. Burns &amp; G. W. Roberts, An Introduction to Mixed-Signal IC Test and Measurement (Oxford Univ. Press, 2001); Wikipedia: Automatic test equipment</admin>
<langSec xml:lang="en"><termSec><term>tester</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ATE</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>テスタ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>試験者</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>検査者</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>試験器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>テスト器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>测试机</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>测试仪</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>测试者</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>试验机</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>检测仪</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>테스터</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>시험자</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>검사기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>시험기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>테스트기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Tester</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Prüfer</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Testgerät</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Prüfling</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>equipo de prueba automático</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>ensayador</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>comprobador</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>verificador</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>probeta</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s049"><descrip type="definition">A temperature sensor made of two dissimilar metal wires joined at the measuring point, producing a small voltage that depends on the junction temperature. Letter-designated types such as K, J and R are used throughout furnaces, heaters and chucks.</descrip><admin type="source">IEC 60584-1 — Thermocouples — Part 1: EMF specifications and tolerances; JIS C 1602 — 熱電対</admin>
<langSec xml:lang="en"><termSec><term>thermocouple</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>TC</term><termNote type="termType">abbreviation</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>熱電対</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>熱電偶</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>サーモカプラ</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>熱電カップル</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>熱電対偶</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>热电偶</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>热电对</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>热电耦合器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>热电偶合器</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>열전대</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>열전 커플러</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>열전 결합기</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>서모커플러</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Thermoelement</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Thermokoppler</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Thermokupplung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>Thermokopplung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>termopar</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>termoacoplador</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>acoplador térmico</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>par termoeléctrico</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
<conceptEntry id="s050"><descrip type="definition">Measurement of the out-of-plane deformation of a package or substrate, usually by shadow moire or laser profilometry, at room temperature and through a reflow temperature profile. JEDEC JESD22-B112 defines the method for surface-mount ICs.</descrip><admin type="source">JEDEC JESD22-B112 — Package Warpage Measurement of Surface-Mount Integrated Circuits at Elevated Temperature</admin>
<langSec xml:lang="en"><termSec><term>warpage measurement</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ja"><termSec><term>反り測定</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>歪み測定</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>変形測定</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="zh"><termSec><term>翘曲测量</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>变形测量</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec><termSec><term>弯曲测量</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="ko"><termSec><term>휨 측정</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>변형 측정</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="de"><termSec><term>Verwölbungsmessung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec><termSec><term>Verformungsmessung</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec></langSec>
<langSec xml:lang="es"><termSec><term>medición de alabeo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec></langSec>
</conceptEntry>
</body></text></tbx>